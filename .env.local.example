# =============================================================================
# Plantilla de .env.local — TODAS las variables que lee el código.
#
#   cp .env.local.example .env.local     y llena los valores
#
# .env.local NO se versiona (.gitignore). Esta plantilla SÍ, y por eso va sin
# un solo valor: si alguna vez aparece aquí una llave, es un incidente.
#
# Cada variable dice DE DÓNDE sale su valor. Las que se leen en varios sitios
# llevan el archivo que las consume, para poder rastrear el efecto de cambiarlas.
#
# ORDEN DE PRECEDENCIA: las variables del shell ganan sobre .env.local en los
# scripts (`{ ...leerEnvLocal(), ...process.env }`). Útil para apuntar una
# corrida a otro destino sin editar el archivo.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SUPABASE — de qué proyecto habla esta copia del repo
#
# Las tres salen del MISMO proyecto. Mezclar la URL de uno con las llaves de
# otro no da un error claro: da 401 intermitentes que cuesta relacionar.
#
#   Local (stack del CLI):  `supabase status`
#   Proyecto remoto:        Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# URL del proyecto. Local: http://127.0.0.1:54321
# Remoto: https://<ref>.supabase.co  — el <ref> identifica el proyecto, y es lo
# ÚNICO que distingue dev de staging a simple vista. Verifícalo antes de correr
# cualquier script: casi todo en este repo es idempotente, pero apuntar a la
# base equivocada no se deshace.
# Leída por: lib/supabase/{admin,client,middleware,server}.ts y todos los scripts.
NEXT_PUBLIC_SUPABASE_URL=

# Llave anónima (pública). Va al navegador; RLS es lo que protege los datos.
# Leída por: lib/supabase/{client,middleware,server}.ts y los scripts E2E.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave service_role — SOLO servidor. Hace BYPASS de RLS: con ella se ve y se
# escribe todo, de todos los tenants. Nunca en código de cliente, nunca en un
# NEXT_PUBLIC_*, nunca en un commit.
# Leída por: lib/supabase/admin.ts y los scripts de alta/import.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# 2. APLICACIÓN — identidad y comportamiento del despliegue
#
# Las NEXT_PUBLIC_* SE INLINEAN EN BUILD. Cambiarlas en Heroku no basta:
# requieren redeploy para tener efecto.
# -----------------------------------------------------------------------------

# Nombre comercial mostrado en la interfaz y en el favicon.
# Default en código si falta: "TRACELINE" (lib/app.ts:5).
# Leída por: lib/app.ts, app/icon.tsx
NEXT_PUBLIC_APP_NAME=

# URL base para construir enlaces absolutos (los CTA de los correos salen de
# aquí). Sin barra final. Local: http://localhost:3000
# Default en código si falta: http://localhost:3000 (lib/app.ts:12) — que en un
# despliegue remoto manda correos con enlaces a la máquina de quien los abre.
# Leída por: lib/app.ts:12
NEXT_PUBLIC_APP_URL=

# ¿Es un despliegue sin dominio propio, que NO debe indexarse?
# Vale "true" SOLO en Heroku (staging y cualquier ambiente con URL de herokuapp).
# Enciende el noindex/nofollow global del layout. En local se deja vacío.
# No confundir con la franja "Entorno de demostración": esa es del tenant
# (tenants.es_demo), no del ambiente.
# Leída por: lib/app.ts:25 (compara === "true")
NEXT_PUBLIC_STAGING=


# -----------------------------------------------------------------------------
# 3. CORREO (Resend)
#
# SIN RESEND_API_KEY el sistema entra en MODO CONSOLA: los correos no se envían,
# se imprimen en el log del servidor. Todo el flujo —solicitar, recordar,
# observar— es probable así. Para un ambiente de DESARROLLO, déjala VACÍA:
# es lo que impide escribirle por accidente a una dirección real.
# -----------------------------------------------------------------------------

# API key de Resend. Dashboard de Resend → API Keys. Vacía = modo consola.
# Leída por: lib/email/enviar.ts:57
RESEND_API_KEY=

# Remitente. Su dominio tiene que estar verificado en Resend o el envío se
# rechaza. Formato: "TRACELINE <avisos@tu-dominio.com>".
# Si hay API key y esto queda vacío, los correos salen desde
# onboarding@resend.dev (dominio de pruebas) y llegan como de un tercero; el
# arranque lo advierte en el log una vez por proceso.
# Leída por: lib/email/enviar.ts:58,79
EMAIL_FROM=


# -----------------------------------------------------------------------------
# 4. CRON DE RECORDATORIOS
# -----------------------------------------------------------------------------

# Secreto que protege POST /api/recordatorios. El job del Heroku Scheduler lo
# manda en el header 'x-cron-secret'; sin coincidencia la ruta responde 401.
# Valor libre: invéntalo por ambiente (uno distinto en dev y en staging).
# El botón manual del panel usa la misma rutina server-side y no lo expone.
# Leída por: app/api/recordatorios/route.ts:34
CRON_SECRET=


# =============================================================================
# 5. SOLO PARA SCRIPTS (E2E, altas e imports). La APLICACIÓN no las lee: no
#    hacen falta en Heroku, solo en la máquina que corre los scripts.
#    Todas tienen default, así que puedes dejarlas vacías y funcionan en local.
# =============================================================================

# Cuenta de staff con rol `admin` que usan los scripts para firmar sus acciones.
# Default: admin@irstrat.example  /  Demo2025!   ← el del seed local.
# En un proyecto remoto, PONLAS: si las dejas vacías, los scripts intentarán
# entrar con la contraseña del seed, que está escrita en este repositorio.
# Leídas por: verify-export.mjs, los 7 e2e-*.mjs, crear-demo-prospecto.mjs,
#             import-gcarso*.mjs
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cuenta de staff con rol `analista` (permisos menores que admin) que varios
# E2E usan para comprobar que ciertas acciones le están vedadas.
# Default: analista@irstrat.example
# Leída por: e2e-{admin-cliente,banner-demo,cambio-password,difusion,
#            recordatorios,vb-area}.mjs
ANALISTA_EMAIL=

# URL de la app contra la que corren los E2E de navegador.
# Default: http://localhost:3000
# Leída por: los 7 e2e-*.mjs
BASE_URL=

# Lo mismo, pero para verify-export.mjs, que usa OTRO nombre (también acepta el
# primer argumento posicional: `node scripts/verify-export.mjs https://...`).
# Default: http://localhost:3000
APP_URL=

# Cuentas del tenant demo que usa e2e-banner-demo.mjs, y su espera para el
# chequeo de noindex (ms).
# Defaults: las del seed / 0
DEMO_AREA_EMAIL=
DEMO_ADMIN_CLIENTE_EMAIL=
ESPERA_NOINDEX=


# =============================================================================
# 6. SALVAGUARDAS — no van en el archivo, se pasan en la línea de comandos
#
# Los scripts que ESCRIBEN datos se niegan a correr contra algo que no sea local
# a menos que se les autorice explícitamente en esa invocación. La idea es que
# apuntar a un proyecto remoto sea un acto deliberado y visible en el historial
# de la terminal, no una variable olvidada en un archivo:
#
#   DEMO_TARGET_OK=1   node scripts/crear-demo-prospecto.mjs      # alta de mockups
#   IMPORT_TARGET_OK=1 node scripts/import-gcarso.mjs             # import GCARSO
#   IMPORT_TARGET_OK=1 node scripts/import-gcarso-historico.mjs
#
# NO las declares aquí: si viven en .env.local, la salvaguarda deja de existir.
# =============================================================================
