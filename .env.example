# =============================================================================
# Plantilla de variables de entorno. Copia a .env.local y ajusta.
#   cp .env.example .env.local
# .env.local NO se versiona (ver .gitignore).
# =============================================================================

# Nombre comercial de la aplicación (PENDIENTE de definir).
# Úsalo SIEMPRE desde esta variable, nunca hardcodeado.
NEXT_PUBLIC_APP_NAME=TRACELINE

# --- Supabase local (valores por defecto del CLI; ver `supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave anónima (pública) del stack local de Supabase:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (NUNCA exponer al cliente). service_role hace BYPASS de RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Correo (Resend) ---------------------------------------------------------
# URL base para los enlaces (CTA) de los correos. En local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# API key de Resend. SIN esta clave el sistema entra en "MODO CONSOLA": los
# correos NO se envían, se imprimen en el log del servidor (destinatario, asunto
# y contenido). Así todo el flujo —solicitar, recordar, observar— es probable en
# local sin cuenta de Resend. Con la clave presente, se envían de verdad.
RESEND_API_KEY=
# Remitente de los correos (dominio verificado en Resend en producción).
# En modo consola es irrelevante. Ejemplo: "Vert <no-reply@tu-dominio.com>"
EMAIL_FROM=

# --- Generador de Suplemento S1/S2 (API de Claude) ---------------------------
# Clave de la API de Anthropic. SIN ella el generador del suplemento no arranca:
# es lo único que no tiene modo de respaldo, porque el texto de los bloques lo
# redacta el modelo. Console de Anthropic → API Keys. Nunca en un commit.
ANTHROPIC_API_KEY=

# --- Cron de recordatorios ---------------------------------------------------
# Secreto que protege POST /api/recordatorios. El cron (Heroku Scheduler) debe
# enviarlo en el header 'x-cron-secret'. El botón manual del panel usa la misma
# rutina server-side (no expone el secreto al navegador).
CRON_SECRET=
