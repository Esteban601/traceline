# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...pero sí versionamos la plantilla de ejemplo
!.env.example

# Supabase (CLI + Docker local)
# Se VERSIONAN: supabase/config.toml, supabase/migrations/**, supabase/seed.sql
# Se IGNORAN: artefactos temporales del CLI y credenciales locales
supabase/.temp/
supabase/.branches/
supabase/logs/
supabase/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase Studio local (snippets guardados desde la UI)
supabase/snippets/
