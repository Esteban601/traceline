# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...pero sí versionamos las plantillas de ejemplo. Van SIN valores: el patrón
# `.env*` de arriba las atraparía, y una plantilla que nadie puede versionar no
# sirve de nada. Cualquier archivo nuevo con valores reales (.env.local y sus
# variantes) sigue ignorado por no estar en esta lista.
!.env.example
!.env.local.example

# Supabase (CLI + Docker local)
# Se VERSIONAN: supabase/config.toml, supabase/migrations/**, supabase/seed.sql
# Se IGNORAN: artefactos temporales del CLI y credenciales locales
supabase/.temp/
supabase/.branches/
supabase/logs/
supabase/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase Studio local (snippets guardados desde la UI)
supabase/snippets/

# Plantillas .xlsx colocadas en la raíz para importar: la copia canónica que
# lee el motor de export vive versionada en assets/ (no duplicar el binario).
/*.xlsx
import-gcarso/

# Respaldos de base de datos tomados a mano antes de una migración.
respaldo-*.sql
logos-demo/

# Contraseñas generadas de los tenants de demostración para prospectos
# (scripts/crear-demo-prospecto.mjs). Cuentas @example de mockups, pero no van
# al repo: una contraseña versionada es una contraseña publicada.
.credenciales-demo/
